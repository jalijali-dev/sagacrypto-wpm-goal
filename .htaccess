# Sagagoal — clean URL rewrites (Fase 9 follow-up).
#
# Written to be portable between local dev (this app may sit in a
# subfolder, e.g. http://localhost/wpm/) and production (app sits at the
# domain root, e.g. https://sagagoal.com/) WITHOUT needing a different
# RewriteBase per environment: every target below is a relative path
# (no leading slash), so Apache resolves it relative to the directory this
# .htaccess lives in — whatever that directory is mounted as.
#
# All existing *.php files keep working directly with their original
# ?slug=/?tag=/?mode= query strings (nothing here breaks old links); this
# just adds pretty aliases on top and is what all internal links now point
# to (see includes/site-bootstrap.php, index.php, artikel.php, kategori.php,
# pencarian.php).
#
# Requires mod_rewrite enabled and AllowOverride All (or at least
# "AllowOverride FileInfo") on the directory — ask your hosting/Docker
# Apache config if these rules don't seem to take effect.

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Canonical domain 301 (22 Aug 2026) — Google Search Console flagged
    # "Duplicate, Google chose different canonical than user": both
    # sagagoal.com and www.sagagoal.com were live with no redirect between
    # them, each self-declaring its own canonical tag (see wpm_site_url()
    # in includes/site-bootstrap.php), so Google had no signal for which
    # one was "real" and sometimes picked www even on pages that declared
    # non-www. GSC's registered property is https://sagagoal.com/
    # (non-www, confirmed in GSC Settings), so www now hard-redirects here
    # — must be the very first rule, before any other rewrite, so it fires
    # regardless of which URL/path was requested. 301 (not 302) so link
    # equity transfers to the non-www version instead of splitting between
    # both indefinitely.
    RewriteCond %{HTTP_HOST} ^www\.sagagoal\.com$ [NC]
    RewriteRule ^ https://sagagoal.com%{REQUEST_URI} [R=301,L]

    # Legacy query-string redirects for football/basket date pages (25 Jul
    # 2026 SEO clean-URL change) — old links like football.php?date=2026-07-25
    # now 301 to the clean path football/2026-07-25. Must come BEFORE the
    # real-file bypass below since football.php/basket.php are real files
    # that bypass would otherwise let straight through unredirected.
    #
    # Matched against THE_REQUEST (the original request line) rather than
    # REQUEST_URI/QUERY_STRING for two reasons: (1) %N backreferences only
    # reflect the LAST matched RewriteCond, not all conds in the chain — a
    # two-condition REQUEST_URI+QUERY_STRING version silently produced a
    # garbled target (%1 ended up bound to the date, %2 to nothing) — so
    # both captures must come from a single condition; (2) THE_REQUEST is
    # frozen at the original browser request and never changes on internal
    # rewrites, so this can't re-match and loop when the clean-URL forward
    # rule below internally rewrites football/DATE -> football.php?date=DATE.
    RewriteCond %{THE_REQUEST} \s(.*)/football\.php\?date=([0-9]{4}-[0-9]{2}-[0-9]{2})\s
    RewriteRule ^ %1/football/%2? [R=301,L]
    RewriteCond %{THE_REQUEST} \s(.*)/basket\.php\?date=([0-9]{4}-[0-9]{2}-[0-9]{2})\s
    RewriteRule ^ %1/basket/%2? [R=301,L]

    # Never rewrite requests that already point at a real file or directory
    # (assets/, cms-admin/, uploads/, the *.php files themselves, etc.).
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Legacy URL redirects (24 Jul 2026 rename — livescore.php/nba.php
    # renamed to football.php/basket.php, see includes/site-bootstrap.php's
    # wpm_url_football()/wpm_url_basket()). 301 (not 302) so search
    # engines transfer ranking to the new URLs instead of indexing both.
    # Must come before the generic rule below since /livescore and /nba
    # no longer correspond to any real .php file.
    #
    # NOTE on the %{REQUEST_URI}-capture trick below: a plain relative
    # target (e.g. `RewriteRule ^livescore/?$ football [R=301,L]`) makes
    # Apache build the Location header from the server FILESYSTEM path
    # instead of a URL path when the [R] flag is used — it works fine for
    # internal (non-R) rewrites but breaks external redirects. Capturing
    # everything in REQUEST_URI before "/livescore" and re-prepending it
    # keeps this portable across "app in a subfolder" (local dev) and
    # "app at domain root" (production) without hardcoding a RewriteBase.
    RewriteCond %{REQUEST_URI} ^(.*)/livescore/?$
    RewriteRule ^ %1/football [R=301,L]
    RewriteCond %{REQUEST_URI} ^(.*)/nba/?$
    RewriteRule ^ %1/basket [R=301,L]

    # Generic extension-less alias: /<name> -> <name>.php for any top-level
    # page whose slug matches its filename exactly (football, basket, f1,
    # pencarian, kontak, etc.) — covers new top-level pages automatically
    # without needing a one-off rule added here every time. Pages whose
    # slug does NOT match their filename (berita -> kategori.php,
    # tentang-kami -> tentang.php) still need their own specific rule below,
    # since this generic rule only handles same-name matches.
    RewriteCond %{REQUEST_FILENAME}\.php -f
    RewriteRule ^([a-zA-Z0-9_-]+)/?$ $1.php [L,QSA]

    # /football/YYYY-MM-DD -> football.php?date=YYYY-MM-DD
    # /basket/YYYY-MM-DD   -> basket.php?date=YYYY-MM-DD
    # (25 Jul 2026 SEO clean-URL change; see includes/site-bootstrap.php's
    # $dateUrl closures in football.php/basket.php which now emit this
    # format instead of the old ?date= query string.)
    RewriteRule ^football/([0-9]{4}-[0-9]{2}-[0-9]{2})/?$ football.php?date=$1 [L,QSA]
    RewriteRule ^basket/([0-9]{4}-[0-9]{2}-[0-9]{2})/?$ basket.php?date=$1 [L,QSA]

    # /artikel/<slug> -> artikel.php?slug=<slug>
    RewriteRule ^artikel/([^/]+)/?$ artikel.php?slug=$1 [L,QSA]

    # /berita/tag/<slug> -> kategori.php?tag=<slug>
    RewriteRule ^berita/tag/([^/]+)/?$ kategori.php?tag=$1 [L,QSA]

    # /berita/kategori/<slug> -> kategori.php?slug=<slug>  (category listing)
    RewriteRule ^berita/kategori/([^/]+)/?$ kategori.php?slug=$1 [L,QSA]

    # /berita -> kategori.php  (all articles)
    RewriteRule ^berita/?$ kategori.php [L,QSA]

    # Legacy aliases (Fase 9) — kept so any old /kategori.../tag links still resolve.
    RewriteRule ^tag/([^/]+)/?$ kategori.php?tag=$1 [L,QSA]
    RewriteRule ^kategori/([^/]+)/?$ kategori.php?slug=$1 [L,QSA]
    RewriteRule ^kategori/?$ kategori.php [L,QSA]

    # /tentang-kami -> tentang.php  (slug doesn't match filename, needs its own rule)
    RewriteRule ^tentang-kami/?$ tentang.php [L,QSA]

    # Sitemaps module (14 Jul 2026) — /sitemap.xml and /sitemap-index.xml
    # both serve the same sitemap index; the four per-type files are the
    # sub-sitemaps it points search engines at. See sitemap.php.
    RewriteRule ^sitemap\.xml$ sitemap.php?type=index [L,QSA]
    RewriteRule ^sitemap-index\.xml$ sitemap.php?type=index [L,QSA]
    RewriteRule ^sitemap-pages\.xml$ sitemap.php?type=pages [L,QSA]
    RewriteRule ^sitemap-articles\.xml$ sitemap.php?type=articles [L,QSA]
    RewriteRule ^sitemap-categories\.xml$ sitemap.php?type=categories [L,QSA]
    RewriteRule ^sitemap-custom\.xml$ sitemap.php?type=custom [L,QSA]

    # Special Pages catch-all (Fase 3, Special Pages & Sports Modules spec,
    # 24 Jul 2026) — admin-managed static pages (Kontak, FAQ, etc.) served
    # through page.php. Must be LAST: every specific route above (and the
    # generic same-name .php alias) gets first crack at the URL; only a
    # slug with no matching file/rule falls through to here. See
    # includes/SpecialPages.php.
    RewriteRule ^([a-z0-9-]+)/?$ page.php?slug=$1 [L,QSA]
</IfModule>

# PWA caching headers (added 20 Aug 2026) — sw.js MUST be no-cache so the
# browser always re-checks it against the server on every registration
# call; a cached stale copy of the service worker script itself is the
# classic way a PWA gets stuck serving an old cache forever after a
# deploy, since the update mechanism depends on the browser actually
# seeing the new script's bytes change. manifest.json gets a short max-age
# instead of no-cache (it changes far less often than app content, but an
# icon/theme-color tweak should still show up reasonably soon, not require
# a hard refresh).
<IfModule mod_headers.c>
    <FilesMatch "^sw\.js$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
    <FilesMatch "^manifest\.json$">
        Header set Cache-Control "public, max-age=3600"
    </FilesMatch>
</IfModule>
